{
  "compilerOptions": {
    "paths": {
      "@/*": ["src/*"]
    },
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.js", "src/**/*.vue", "vite.config.js", "eslint.config.js"]
}
